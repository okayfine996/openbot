{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbot-personal-signal-20261115",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "SIGNAL_ROOM", "class_name": "SignalRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }],
  "routes": [],
  "vars": {
    "REMOTE_TICKET_JWKS_URL": "https://openbot-personal-auth-20261115.tianrandailoving.workers.dev/.well-known/jwks.json",
    "TURN_PROVIDER": "cloudflare-realtime",
    "REMOTE_CONTROL_PLANE_URL": "https://openbot-personal-auth-20261115.tianrandailoving.workers.dev"
  },
  "secrets": {
    "required": ["REMOTE_SESSION_SECRET", "REMOTE_AUTH_WEBHOOK_SECRET"]
  },
  "env": {
    "preview": {
      "name": "openbot-signal-worker-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "durable_objects": {
        "bindings": [{ "name": "SIGNAL_ROOM", "class_name": "SignalRoom" }]
      },
      "migrations": [{ "tag": "v1-preview", "new_sqlite_classes": ["SignalRoom"] }],
      "vars": {
        "REMOTE_TICKET_JWKS_URL": "http://127.0.0.1:3100/.well-known/jwks.json",
        "TURN_PROVIDER": "disabled",
        "REMOTE_CONTROL_PLANE_URL": "http://127.0.0.1:3100"
      },
      "secrets": { "required": [] }
    }
  }
}
