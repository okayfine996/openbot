{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbot-signal-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "SIGNAL_ROOM", "class_name": "SignalRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }],
  "routes": [{ "pattern": "signal-worker.openbot.run", "custom_domain": true }],
  "vars": {
    "REMOTE_TICKET_JWKS_URL": "https://api.openbot.run/.well-known/jwks.json",
    "TURN_PROVIDER": "cloudflare-realtime"
  },
  "secrets": {
    "required": [
      "REMOTE_SESSION_SECRET",
      "REMOTE_AUTH_WEBHOOK_SECRET",
      "SLACK_SIGNING_SECRET",
      "GITHUB_WEBHOOK_SECRET",
      "TELEGRAM_BOT_TOKENS",
      "TELEGRAM_WEBHOOK_SECRET",
      "CLOUDFLARE_TURN_KEY_ID",
      "CLOUDFLARE_TURN_API_TOKEN"
    ]
  },
  "env": {
    "preview": {
      "name": "openbot-signal-worker-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "durable_objects": {
        "bindings": [{ "name": "SIGNAL_ROOM", "class_name": "SignalRoom" }]
      },
      "migrations": [{ "tag": "v1-preview", "new_sqlite_classes": ["SignalRoom"] }],
      "vars": {
        "REMOTE_TICKET_JWKS_URL": "http://127.0.0.1:3100/.well-known/jwks.json",
        "TURN_PROVIDER": "disabled"
      },
      "secrets": { "required": [] }
    }
  }
}
